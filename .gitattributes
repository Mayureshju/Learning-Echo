*.mp4 filter=lfs diff=lfs merge=lfs -text

# Force critical build and script files to use LF line endings for cross-platform compatibility
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Windows batch files need CRLF line endings
*.bat text eol=crlf
